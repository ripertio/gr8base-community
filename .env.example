# Copy to .env and fill in. Comments are on their own lines on purpose.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
POSTGRES_PASSWORD=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Cloudflare dashboard: Access -> Tunnels -> <your-tunnel> -> Get your token
CLOUDFLARE_TUNNEL_TOKEN=
# resend.com -> API Keys
RESEND_API_KEY=

# Optional, used by scripts/backup.sh (plain values, no quotes)
# BACKUP_DIR=/home/youruser/gr8base-backups
# KEEP_DAYS=14
# Host path of the media mount; used by compose AND backup.sh (dev: ./data-dev/media)
# MEDIA_DIR=./data/media
# rsync target, or rclone:remote:bucket/path
# BACKUP_REMOTE=user@host:/backups/gr8base
# Pinged after a successful backup (e.g. https://hc-ping.com/<uuid>)
# BACKUP_HEARTBEAT_URL=
